{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "buildCommand": "node scripts/inject-token.js",
  "outputDirectory": "."
}
